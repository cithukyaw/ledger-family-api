{
  "name": "ledger-family-api",
  "version": "1.0.0",
  "description": "The family ledger management API",
  "main": "index.js",
  "scripts": {
    "build": "tsc --build",
    "prebuild": "prisma generate",
    "migrate": "prisma migrate deploy && prisma generate",
    "seed": "prisma db seed",
    "mcp:key": "tsx scripts/generateMcpApiKey.ts",
    "dev": "cross-env NODE_ENV=development tsx watch ./src/index.ts",
    "prod": "cross-env NODE_ENV=production node ./build/index.js",
    "start": "npm run build && npm run migrate && npm run seed && npm run prod",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "tsx copy-env.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.10",
    "cross-env": "^7.0.3",
    "prisma": "^7.6.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module"
}
